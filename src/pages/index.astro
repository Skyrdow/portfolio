---
import Layout from '@layouts/Layout.astro';
import Suchai4 from '@components/SUCHAI4.svelte';

const habilidades = [
	'Lenguajes: C, Python, Go, TypeScript, C++, Java, C#, SQL',
	'Sistemas embebidos: FreeRTOS, GNU/Linux, CMake, GCC',
	'Backend & Web: Node.js, Spring Boot, Svelte, Astro, React, Vue, Tailwind CSS',
	'Testing & DevOps: Git, GitLab, Docker Compose, SQLite',
	'Cloud: Vercel, Azure'
];

interface Proyecto {
	titulo: string;
	descripcion: string;
	tecnologias: string[];
	url: string;
}

const proyectos: Proyecto[] = [
	{
		titulo: 'Recursos de Aprendizaje de Castellano',
		descripcion:
			'Plataforma de recursos didácticos para el aprendizaje del castellano para escolares. Solicitado por la Facultad de Humanidades USACH.',
		tecnologias: ['Vue.js', 'Go', 'Tailwind CSS'],
		url: 'https://www.recursosaprendizajecastellano.usach.cl/'
	},
	{
		titulo: 'Fonética y Poética',
		descripcion:
			'Sitio del 1er congreso de fonética y poética. Solicitado por la Facultad de Humanidades USACH.',
		tecnologias: ['Astro', 'TypeScript', 'Tailwind CSS'],
		url: 'https://foneticaypoetica.usach.cl/'
	},
	{
		titulo: 'English Pronunciation',
		descripcion:
			'Herramienta web para practicar la pronunciación del inglés con guías visuales de posición de boca y retroalimentación de audio. No trabajé personalmente en este proyecto, fué realizado por otros miembros de OSUSACH.',
		tecnologias: ['Astro', 'Svelte', 'Tailwind CSS'],
		url: 'https://englishpronunciation.cl/'
	}
];
---

<Layout title="Lucas Mesías — Ingeniero Civil en Informática">
	<!-- Hero -->
	<section class="mb-16">
		<div class="flex flex-col gap-8 md:flex-row md:items-start md:gap-12">
			<div class="flex-1">
				<h1 class="mb-4 text-4xl font-black">Ingeniero Civil en Informática</h1>
				<p class="mb-2 text-lg font-bold text-neutral-500">Universidad de Santiago de Chile</p>
				<p class="mb-6 text-lg leading-relaxed text-neutral-700">
					Experiencia desarrollando software de vuelo y sistemas críticos en C, además de
					automatización con Python e interfaces web modernas.
				</p>
				<div class="flex flex-wrap gap-3">
					<span
						class="rounded-full border-2 border-black bg-yellow-200 px-3 py-1 text-xs font-bold neob-border"
					>
						TypeScript
					</span>
					<span
						class="rounded-full border-2 border-black bg-sky-200 px-3 py-1 text-xs font-bold neob-border"
					>
						C / C++
					</span>
					<span
						class="rounded-full border-2 border-black bg-green-200 px-3 py-1 text-xs font-bold neob-border"
					>
						Python
					</span>
					<span
						class="rounded-full border-2 border-black bg-orange-200 px-3 py-1 text-xs font-bold neob-border"
					>
						Svelte / Astro
					</span>
					<span
						class="rounded-full border-2 border-black bg-purple-200 px-3 py-1 text-xs font-bold neob-border"
					>
						Go
					</span>
				</div>
			</div>

			<div class="neob-border w-full max-w-sm bg-lime-100 p-6 md:w-72">
				<h2 class="mb-3 font-black">Contacto</h2>
				<ul class="space-y-2 text-sm">
					<li class="font-bold">Lucas Mesías</li>
					<li>
						<a href="https://github.com/skyrdow" class="underline hover:no-underline"
							>github.com/skyrdow</a
						>
					</li>
					<li>
						<a href="mailto:lucas.mesias@usach.cl" class="underline hover:no-underline"
							>lucas.mesias@usach.cl</a
						>
					</li>
					<li>+56 9 3343 3172</li>
					<li>Santiago, Chile</li>
				</ul>
			</div>
		</div>
	</section>

	<!-- Experiencia -->
	<section class="mb-16">
		<h2 class="mb-4 text-2xl font-black">Experiencia</h2>
		<div class="space-y-4">
			<div class="neob-border bg-sky-50 p-4">
				<div class="flex items-start justify-between">
					<h3 class="font-black">Desarrollador de software de vuelo</h3>
					<span class="text-xs text-neutral-500">Sept 2025 – Ago 2026</span>
				</div>
				<p class="text-sm font-bold text-neutral-600">SPEL / Scy-Fi Lab</p>
				<ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-neutral-700">
					<li>
						Diseñé e implementé dos sistemas autónomos para SUCHAI FS, destinados a coordinar y
						ejecutar más de 60 experimentos científicos de la misión CubeSat SUCHAI 4.
					</li>
					<li>
						Desarrollé en C un sistema de cambios automáticos de modo operacional, incluido el
						ingreso a modo seguro por bajo voltaje, y un sistema persistente de secuencias de
						comandos con bifurcaciones condicionales y recuperación ante reinicios.
					</li>
					<li>
						Automaticé pruebas de integración Software-in-the-Loop con Python, tbot, ZeroMQ y
						SQLite, simulando múltiples nodos para validar el intercambio de comandos y datos.
					</li>
					<li>
						Colaboré con el equipo de hardware en el levantamiento de requisitos y contribuí a
						reducir el uso de memoria dinámica y resolver advertencias de compilación en SUCHAI FS.
					</li>
				</ul>
			</div>
			<div class="neob-border bg-sky-50 p-4">
				<div class="flex items-start justify-between">
					<h3 class="font-black">Desarrollador de software (práctica)</h3>
					<span class="text-xs text-neutral-500">Abr 2025 – Ene 2026</span>
				</div>
				<p class="text-sm font-bold text-neutral-600">
					CITIAPS / Dirección Estratégica de Informática
				</p>
				<ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-neutral-700">
					<li>
						Colaboré con SEGIC en la automatización de flujos de datos multiplataforma,
						implementando web scraping con Puppeteer para extraer y sincronizar información desde
						PeopleSoft.
					</li>
					<li>
						Desarrollé junto al Departamento de Relaciones Internacionales un sistema de
						procesamiento documental con OCR y la API de Gemini, automatizando la traducción de
						textos y reduciendo los tiempos de respuesta del área.
					</li>
				</ul>
			</div>
			<div class="neob-border bg-green-50 p-4">
				<div class="flex items-start justify-between">
					<h3 class="font-black">Cofundador y líder técnico</h3>
					<span class="text-xs text-neutral-500">Ago 2023 – Actualidad</span>
				</div>
				<p class="text-sm font-bold text-neutral-600">OSUSACH</p>
				<ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-neutral-700">
					<li>
						Coordiné equipos y la relación con clientes de la Universidad de Santiago de Chile,
						incluidos la Facultad de Humanidades y el Congreso Internacional de Fonética y Poética,
						desde el levantamiento de necesidades hasta el despliegue.
					</li>
					<li>
						Desarrollé interfaces web con Astro, Svelte y Tailwind CSS para diversos proyectos
						institucionales.
					</li>
				</ul>
			</div>
		</div>
	</section>

	<!-- SUCHAI 4 Orbit -->
	<section class="mb-16">
		<h2 class="mb-2 text-2xl font-black">SUCHAI 4 — Orbital Tracker</h2>
		<p class="mb-4 text-sm text-neutral-600">
			Trayectoria orbital real del CubeSat SUCHAI 4. Datos propagados desde TLE oficial.
		</p>
		<div class="space-y-3">
			<div class="relative h-[500px]">
				<Suchai4 client:only="svelte" />
				<div
					id="suchai-skeleton"
					class="neob-border absolute inset-0 z-10 flex h-[500px] items-center justify-center bg-neutral-100"
				>
					<div class="text-sm font-bold text-neutral-400">Cargando...</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Habilidades -->
	<section class="mb-16">
		<h2 class="mb-4 text-2xl font-black">Habilidades técnicas</h2>
		<div class="grid gap-3 sm:grid-cols-2">
			{habilidades.map((h) => <div class="neob-border-inset bg-neutral-50 p-3 text-sm">{h}</div>)}
		</div>
	</section>

	<!-- Proyectos -->
	<section class="space-y-8">
		<h2 class="text-2xl font-black">Proyectos web</h2>
		{
			proyectos.map((p) => (
				<article class="space-y-4">
					<div class="flex items-start justify-between gap-4">
						<div>
							<h3 class="text-xl font-black">{p.titulo}</h3>
							<p class="text-sm text-neutral-600">{p.descripcion}</p>
						</div>
						<a
							href={p.url}
							target="_blank"
							rel="noopener noreferrer"
							class="neob-clickable shrink-0 bg-yellow-200 px-4 py-2 text-xs font-bold"
						>
							Ver sitio ↗
						</a>
					</div>
					<div class="neob-border overflow-hidden bg-white">
						<div class="border-b-2 border-black bg-neutral-100 px-4 py-2 text-xs font-bold">
							{p.url}
						</div>
						<div class="relative h-[500px]">
							<div class="skeleton-pulse absolute inset-0 flex items-center justify-center bg-neutral-100">
								<div class="text-sm font-bold text-neutral-400">Cargando preview...</div>
							</div>
							<iframe
								src={p.url}
								class="h-full w-full border-0"
								loading="lazy"
								sandbox="allow-scripts allow-same-origin"
								title={p.titulo}
								onload="this.previousElementSibling.style.display='none'"
							/>
						</div>
					</div>
					<div class="flex flex-wrap gap-2">
						{p.tecnologias.map((t) => (
							<span class="rounded-full border neob-border bg-white px-3 py-1 text-xs">{t}</span>
						))}
					</div>
				</article>
			))
		}
	</section>
</Layout>
